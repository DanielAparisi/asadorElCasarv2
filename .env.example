# Copia este archivo a `.env` y rellena los valores del proyecto de Supabase
# (Project Settings → API). El `.env` real no se sube al repo.
#
# Solo variables `VITE_`: en una app 100 % cliente, todo lo que Vite inyecta
# acaba en el bundle y es público. Cualquier clave que deba seguir siendo
# secreta va en una Edge Function, nunca aquí.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# El dominio público, sin barra final (por ejemplo https://asadorelcasar.es).
# Se usa para las etiquetas que necesitan una URL absoluta: la vista previa del
# enlace en WhatsApp, el `canonical` y la ficha de Google. Si se deja vacío,
# esas etiquetas no se escriben — mejor eso que un dominio inventado, porque
# una URL equivocada rompe la vista previa para todo el mundo.
VITE_SITE_URL=
